{
  "name": "@paylix/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for accepting crypto payments and subscriptions with Paylix.",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanoTheDev/paylix.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "crypto",
    "payments",
    "usdc",
    "stablecoin",
    "base",
    "subscriptions",
    "web3",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@paylix/config": "workspace:*",
    "@types/node": "25.5.2",
    "tsup": "^8",
    "typescript": "^5.5",
    "vitest": "^4.1.4"
  }
}
